# Copy to .env.local and fill in from your Supabase project (Project Settings → API)
# Create a free project at https://supabase.com

# Public (safe for the browser)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Server-only — NEVER expose this in the browser. Used only by scripts/seed.mjs
# (Project Settings → API → service_role secret)
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-SECRET

# The date the 60-day program starts (YYYY-MM-DD). Drives "today's tasks".
NEXT_PUBLIC_PROGRAM_START=2026-09-01
